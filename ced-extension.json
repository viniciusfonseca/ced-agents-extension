{
  "manifestVersion": 1,
  "id": "viniciusfonseca.agents",
  "name": "Agents",
  "version": "0.4.19",
  "description": "Manage Codex, Claude Code and Devin sessions over ACP.",
  "license": "MIT",
  "ced": {
    "minVersion": "0.2.0",
    "apiMajor": 1
  },
  "kind": "executable",
  "entrypoints": {
    "darwin-arm64": "bin/darwin-arm64/agents",
    "darwin-x86_64": "bin/darwin-x86_64/agents",
    "linux-arm64": "bin/linux-arm64/agents",
    "linux-x86_64": "bin/linux-x86_64/agents",
    "windows-arm64": "bin/windows-arm64/agents.exe",
    "windows-x86_64": "bin/windows-x86_64/agents.exe",
    "windows-i686": "bin/windows-i686/agents.exe"
  },
  "activationEvents": [
    "onCommand:viniciusfonseca.agents.open"
  ],
  "capabilities": [],
  "untrustedWorkspaces": false,
  "contributes": {
    "commands": [
      {
        "id": "viniciusfonseca.agents.open",
        "title": "Open Agents",
        "category": "Agents"
      }
    ],
    "tabs": [
      {
        "id": "viniciusfonseca.agents.panel",
        "title": "Agents",
        "panel": "terminal",
        "command": "viniciusfonseca.agents.open"
      }
    ]
  }
}
